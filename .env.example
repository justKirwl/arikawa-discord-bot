# Copy to .env and fill in real values. Never commit .env.
DISCORD_KEY=

# Postgres DSN used by the bot.
PSQL_URL=

# Published ports for docker compose.
ROOMD_HTTP_PORT=8080
ROOMD_GRPC_PORT=50051

# Ed25519 room-token public key (base64url). Leave commented to use the dev key
# from docker-compose.yml; set ROOMD_JWT_KEY_ID too when rotating keys.
# ROOMD_JWT_PUBLIC_KEY=
# ROOMD_JWT_ISSUER=cinema-bot
# ROOMD_JWT_KEY_ID=dev-2026-11
